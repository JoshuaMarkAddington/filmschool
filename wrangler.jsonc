{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filmschool",
  "compatibility_date": "2026-04-02",
  "observability": {
    "enabled": true
  },
  "main": "src/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "filmschool",
      "database_id": "0add03d2-c595-4565-872b-c1522cb75efa"
    }
  ]
}
